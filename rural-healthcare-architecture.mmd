flowchart TB
  subgraph Users[Users]
    P[Patient / Caregiver]
    HW[Community Health Worker]
    FS[Facility Staff]
    AD[District Administrator]
  end

  subgraph Experience[Experience Layer]
    PWA[Responsive PWA\nPatient + Health Worker Workspace]
    SOS[SOS / Quick Emergency Widget]
    DASH[Admin Dashboard]
    IDB[(IndexedDB\nOffline Cache + Outbox)]
  end

  subgraph Edge[Edge Layer]
    CDN[HTTPS CDN / Static Hosting]
    API[API Reverse Proxy\nTLS + Rate Limits]
  end

  subgraph Backend[Backend Modular Monolith]
    IAM[Identity + RBAC]
    DISC[Discovery + Ranking]
    FAC[Facility Registry]
    AVL[Availability + Freshness]
    REF[Referral Coordination]
    EMG[Emergency & SOS Coordinator]
    FB[Feedback + Data Quality]
    LOC[Localization]
    AUD[Audit + Domain Events]
    JOB[Background Jobs]
  end

  subgraph Data[Data Layer]
    DB[(PostgreSQL\n+ PostGIS)]
    CACHE[(Optional Redis Cache)]
    STORE[(Optional Object Storage)]
  end

  subgraph Integrations[Integration Adapters]
    MAP[Maps / Directions]
    NOTIF[SMS / Push / Messaging]
    TELE[Telemedicine Link]
    AMB[Ambulance / Emergency Dispatch]
    GOV[Future Government Health Systems]
  end

  subgraph Ops[Operations]
    OBS[Logs + Metrics + Tracing]
    BKP[Backups + Restore]
  end

  P --> PWA
  HW --> PWA
  FS --> PWA
  AD --> DASH
  PWA <--> IDB
  PWA --> CDN
  DASH --> CDN
  CDN --> API
  
  P --> SOS
  HW --> SOS
  SOS --> CDN

  API --> IAM
  API --> DISC
  API --> FAC
  API --> AVL
  API --> REF
  API --> EMG
  API --> FB
  API --> LOC
  API --> AUD

  DISC --> FAC
  DISC --> AVL
  REF --> FAC
  REF --> AVL
  FB --> FAC
  JOB --> AVL
  JOB --> REF
  JOB --> FB
  EMG --> FAC

  IAM --> DB
  FAC --> DB
  AVL --> DB
  REF --> DB
  EMG --> DB
  FB --> DB
  AUD --> DB
  DISC --> CACHE
  DISC --> DB
  JOB --> CACHE
  REF --> NOTIF
  JOB --> NOTIF
  DISC --> MAP
  REF --> TELE
  EMG --> AMB
  EMG --> NOTIF
  JOB --> GOV
  FAC --> STORE

  API --> OBS
  JOB --> OBS
  DB --> BKP

  classDef user fill:#eef2ff,stroke:#4f46e5,color:#111827;
  classDef app fill:#ecfdf5,stroke:#059669,color:#111827;
  classDef infra fill:#fff7ed,stroke:#ea580c,color:#111827;
  classDef data fill:#fdf2f8,stroke:#db2777,color:#111827;
  classDef ops fill:#f3f4f6,stroke:#4b5563,color:#111827;
  class P,HW,FS,AD user;
  class PWA,DASH,IDB,IAM,DISC,FAC,AVL,REF,EMG,SOS,FB,LOC,AUD,JOB app;
  class CDN,API,MAP,NOTIF,TELE,AMB,GOV infra;
  class DB,CACHE,STORE data;
  class OBS,BKP ops;
