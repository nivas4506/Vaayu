{
  "name": "vaayu-platform",
  "version": "1.0.0",
  "description": "Vaayu Rural Healthcare Discovery, ASHA Assisted Referral, and Capacity Coordination Platform",
  "main": "dist/backend/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/backend/src/db', {recursive: true}); fs.copyFileSync('backend/src/db/schema.sql', 'dist/backend/src/db/schema.sql'); })\"",
    "start": "node dist/backend/src/server.js",
    "seed": "tsx backend/src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "redis": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
