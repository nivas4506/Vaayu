{
  "name": "vaayu-platform",
  "version": "1.0.0",
  "description": "VAAYU - Decentralized and Dynamic Rural Healthcare Discovery and Referral Platform",
  "main": "dist/backend/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix Frontend run build",
    "start": "node dist/backend/src/server.js",
    "seed": "tsx backend/src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "pg-mem": "^3.0.4",
    "redis": "^4.7.0",
    "twilio": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^2.0.5"
  }
}
