<mxfile host="app.diagrams.net" modified="2026-08-31T11:25:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="custom-otp-sms-architecture" name="Custom OTP &amp; SMS API Architecture">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title_block" value="Custom OTP &amp; SMS Dispatch API Architecture (For Login &amp; Emergency SOS)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- LAYER 1: CLIENT APPLICATIONS LAYER -->
        <mxCell id="grp_clients" value="1. Client &amp; Application Layer (Consumers)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="1020" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Citizen / Patient Web App&lt;br&gt;&lt;small&gt;(React 19 / Vite SPA)&lt;/small&gt;&lt;br&gt;&lt;b&gt;• Phone Login OTP&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Emergency SOS Button&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;" vertex="1" parent="grp_clients">
          <mxGeometry x="30" y="35" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="ASHA &amp; Staff Mobile PWA&lt;br&gt;&lt;small&gt;(Offline-Ready Workspace)&lt;/small&gt;&lt;br&gt;&lt;b&gt;• Staff Auth / OTP&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Field SOS Dispatch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontColor=#047857;fontSize=11;" vertex="1" parent="grp_clients">
          <mxGeometry x="280" y="35" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Hospital Dashboard &amp; Admin&lt;br&gt;&lt;small&gt;(Bed &amp; Referral Desk)&lt;/small&gt;&lt;br&gt;&lt;b&gt;• 2FA Admin OTP&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Referral SMS Alerts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#b45309;fontSize=11;" vertex="1" parent="grp_clients">
          <mxGeometry x="530" y="35" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="External Apps &amp; Systems&lt;br&gt;&lt;small&gt;(3rd-Party APIs / Webhooks)&lt;/small&gt;&lt;br&gt;&lt;b&gt;• POST /api/v1/otp/send&lt;/b&gt;&lt;br&gt;&lt;b&gt;• POST /api/v1/sms/send&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=11;" vertex="1" parent="grp_clients">
          <mxGeometry x="780" y="35" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- LAYER 2: YOUR CUSTOM API GATEWAY & BUSINESS ENGINE -->
        <mxCell id="grp_api" value="2. Your Custom Backend API (Express / Node.js Engine)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontStyle=1;fontSize=13;fontColor=#312e81;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="1020" height="230" as="geometry" />
        </mxCell>

        <mxCell id="api_gw" value="API Gateway &amp; Protection&lt;br&gt;&lt;small&gt;• Rate Limiting (5 req/min)&lt;br&gt;• API Key / JWT Auth&lt;br&gt;• Phone Sanitizer (+91)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;fontStyle=1;fontColor=#1e1b4b;" vertex="1" parent="grp_api">
          <mxGeometry x="30" y="40" width="170" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mod_otp" value="OTP Management Engine&lt;br&gt;&lt;small&gt;• 6-Digit Crypto Generator&lt;br&gt;• TTL Expiry (5-10 Mins)&lt;br&gt;• Attempt Counter &amp; Lockout&lt;br&gt;• Master Bypass (Demo/Test)&lt;br&gt;• OTP Verification &amp; Token Issue&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="grp_api">
          <mxGeometry x="240" y="40" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mod_sos" value="Emergency SOS Alert Service&lt;br&gt;&lt;small&gt;• Geolocation Enrichment&lt;br&gt;• Nearest Facility Matching&lt;br&gt;• Ambulance ID Assignment&lt;br&gt;• Multi-Contact Broadcast List&lt;br&gt;• Audit Log &amp; Incident Record&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="grp_api">
          <mxGeometry x="500" y="40" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mod_dispatch" value="Pluggable Notification Router&lt;br&gt;&lt;small&gt;• Unified dispatchSms() Interface&lt;br&gt;• Failover / Retry Logic&lt;br&gt;• Delivery Status Webhook&lt;br&gt;• Indian DLT Template Parser&lt;br&gt;• WhatsApp / SMS Dual Route&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontStyle=1;fontColor=#065f46;" vertex="1" parent="grp_api">
          <mxGeometry x="760" y="40" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- LAYER 3: STATE & CACHING LAYER -->
        <mxCell id="grp_state" value="3. Storage, State &amp; Audit Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontSize=13;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="50" y="485" width="480" height="135" as="geometry" />
        </mxCell>
        <mxCell id="db_redis" value="Redis Cache / In-Memory Store&lt;br&gt;&lt;small&gt;• Key: `otp:{phone}` (TTL 300s)&lt;br&gt;• Rate limit buckets (`limit:{ip}`)&lt;br&gt;• High-speed lock &amp; lookup&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#d97706;fontStyle=1;fontColor=#92400e;" vertex="1" parent="grp_state">
          <mxGeometry x="30" y="35" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db_pg" value="PostgreSQL Database&lt;br&gt;&lt;small&gt;• `sos_triggers` (Incident Log)&lt;br&gt;• `audit_events` (SMS Sent Hist)&lt;br&gt;• `sms_delivery_reports`&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#d97706;fontStyle=1;fontColor=#92400e;" vertex="1" parent="grp_state">
          <mxGeometry x="250" y="35" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- LAYER 4: SMS DISPATCH ENGINES & GATEWAYS -->
        <mxCell id="grp_gateways" value="4. SMS &amp; Telecom Transmission Channels (Pluggable Endpoints)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=13;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="570" y="485" width="500" height="275" as="geometry" />
        </mxCell>
        <mxCell id="gw_fast2sms" value="Option A: Fast2SMS / 2Factor / MSG91&lt;br&gt;&lt;small&gt;• Fast Indian Telecom SMS Route (Quick &amp; Cheap)&lt;br&gt;• DLT Approved SMS / OTP Templates&lt;br&gt;• High deliverability to Airtel/Jio/Vi/BSNL&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontStyle=1;fontColor=#166534;" vertex="1" parent="grp_gateways">
          <mxGeometry x="25" y="35" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw_gsm" value="Option B: Local Android GSM Gateway (100% Free)&lt;br&gt;&lt;small&gt;• Android Phone + SIM Card running HTTP SMS Server&lt;br&gt;• Uses your SIM unlimited SMS pack with 0 API cost&lt;br&gt;• Ideal for tests, local deployments, &amp; hackathons&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontStyle=1;fontColor=#075985;" vertex="1" parent="grp_gateways">
          <mxGeometry x="25" y="95" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw_twilio" value="Option C: Twilio / AWS SNS (Global Route)&lt;br&gt;&lt;small&gt;• International E.164 SMS Delivery&lt;br&gt;• Twilio Verify &amp; Messaging API&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontStyle=1;fontColor=#9a3412;" vertex="1" parent="grp_gateways">
          <mxGeometry x="25" y="155" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw_whatsapp" value="Option D: WhatsApp Business / Twilio WhatsApp&lt;br&gt;&lt;small&gt;• Instant rich-text SOS emergency alerts with GPS location links&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;fontStyle=1;fontColor=#15803d;" vertex="1" parent="grp_gateways">
          <mxGeometry x="25" y="215" width="450" height="50" as="geometry" />
        </mxCell>

        <!-- RECIPIENT ENDPOINTS -->
        <mxCell id="grp_end" value="End Recipients" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#c026d3;fontStyle=1;fontSize=13;fontColor=#701a75;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rec1" value="Citizen / Patient&lt;br&gt;&lt;small&gt;Receives 6-digit OTP SMS&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;fontColor=#701a75;fontStyle=1;" vertex="1" parent="grp_end">
          <mxGeometry x="20" y="35" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rec2" value="Emergency Contact&lt;br&gt;&lt;small&gt;Receives SOS Alert SMS/WA&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#991b1b;fontStyle=1;" vertex="1" parent="grp_end">
          <mxGeometry x="170" y="35" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rec3" value="Ambulance / PHC Desk&lt;br&gt;&lt;small&gt;Receives Dispatch Notification&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e3a8a;fontStyle=1;" vertex="1" parent="grp_end">
          <mxGeometry x="330" y="35" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- CONNECTIONS & DATA FLOWS -->
        <!-- Layer 1 to Gateway -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4f46e5;strokeWidth=2;" edge="1" parent="1" source="c1" target="api_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4f46e5;strokeWidth=2;" edge="1" parent="1" source="c2" target="api_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4f46e5;strokeWidth=2;" edge="1" parent="1" source="c3" target="api_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4f46e5;strokeWidth=2;" edge="1" parent="1" source="c4" target="api_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Within Layer 2 -->
        <mxCell id="e5" value="Auth &amp; OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;" edge="1" parent="grp_api" source="api_gw" target="mod_otp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="SOS Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;" edge="1" parent="grp_api" source="api_gw" target="mod_sos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Send OTP SMS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;" edge="1" parent="grp_api" source="mod_otp" target="mod_dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Send SOS SMS/WA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;" edge="1" parent="grp_api" source="mod_sos" target="mod_dispatch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="140" />
              <mxPoint x="740" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Layer 2 to State -->
        <mxCell id="e9" value="Store/Verify OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;" edge="1" parent="1" source="mod_otp" target="db_redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="Log Incident" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;" edge="1" parent="1" source="mod_sos" target="db_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dispatch Router to Gateway Providers -->
        <mxCell id="e11" value="HTTP POST / REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;" edge="1" parent="1" source="mod_dispatch" target="grp_gateways">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateways to End Recipients -->
        <mxCell id="e12" value="SMS Broadcast / WhatsApp Alert via Telecom Towers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c026d3;strokeWidth=2;fontColor=#701a75;fontStyle=1;" edge="1" parent="1" source="grp_gateways" target="grp_end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="700" />
              <mxPoint x="550" y="700" />
            </Array>
          </mxGeometry>
