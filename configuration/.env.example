# Vaayu Rural Healthcare Configuration Template

# Server Port
PORT=3000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Database Mode
# Set to 'true' to run instant zero-dependency in-memory PostgreSQL (pg-mem)
# Set to 'false' to connect to local/cloud PostgreSQL via DATABASE_URL
USE_PG_MEM=true

# Real PostgreSQL Connection String (used when USE_PG_MEM=false)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vaayu

# Data Freshness Window (in hours) before status updates are flagged as stale
FRESHNESS_WINDOW_HOURS=48
