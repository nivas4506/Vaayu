{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["backend/src/*"],
      "@api/*": ["api/*"],
      "@config/*": ["configuration/*"]
    }
  },
  "include": [
    "backend/src/**/*",
    "api/**/*",
    "configuration/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".dist"]
}
